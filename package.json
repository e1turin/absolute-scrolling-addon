{
  "name": "absolute-scrolling",
  "version": "0.2.0",
  "private": true,
  "description": "Absolute-position middle-mouse scrolling for Firefox.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "lint": "web-ext lint --source-dir extension --warnings-as-errors",
    "test": "node --test tests/*.test.js",
    "check": "npm run lint && npm test",
    "build": "web-ext build --source-dir extension --artifacts-dir dist --overwrite-dest",
    "start": "node scripts/start-firefox.js",
    "demo": "node scripts/demo-server.js"
  },
  "devDependencies": {
    "selenium-webdriver": "4.50.0",
    "web-ext": "10.7.0"
  }
}
